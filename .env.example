# Copy to .env and fill in. Every value here is read via core/src/settings.py —
# nothing in the codebase reads os.environ directly.

# ── Postgres ────────────────────────────────────────────────────────────────
# Raw asyncpg DSN. NOT SQLAlchemy's postgresql+asyncpg:// form — asyncpg cannot
# parse it.
POSTGRES_DSN=postgresql://app:app@postgres:5432/recruiter
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ── Neo4j (skill graph + vector retrieval) ──────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=recruiterpass

# ── Redis (arq broker + embedding cache) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Host ports (UNIQUE per machine — avoid collisions with other apps) ───────
# Only the HOST-published side; the in-network service ports are unchanged, so
# the DSNs above (postgres:5432, neo4j:7687, redis:6379, api:8000) still work.
# docker-compose.yml reads these as ${X_PORT:-<stock>}, so leaving them unset
# falls back to the stock ports (5432/6379/7474/7687/8000/5000). This machine
# runs many projects' containers, so the stack ships on a unique 29xxx block;
# scripts/quickstart.ps1 writes these into .env automatically.
API_PORT=29800
FRONTEND_PORT=29500
POSTGRES_PORT=29432
REDIS_PORT=29379
NEO4J_HTTP_PORT=29474
NEO4J_BOLT_PORT=29687

# ── Inference — OpenAI-compatible Ollama. OFFLINE ONLY (never a cloud host). ─
# The stack needs BOTH models reachable at LLM_BASE_URL: gpt-oss:20b (generation)
# and nomic-embed-text (embeddings). Two supported setups:
#
#   (A) Shared Tailscale Ollama (this team's default) — a peer on the tailnet
#       already has both models pulled + calibrated. Your box MUST be joined to
#       the tailnet. This is the value shipped below:
#           LLM_BASE_URL=http://100.88.247.106:11434/v1
#           LLM_TIMEOUT_S=300     # gpt-oss:20b is ~23.5 tok/s → 3072 tok ≈ 131s
#
#   (B) Fully local Ollama on host metal — no tailnet needed, but YOU must pull
#       the models (`ollama serve` then `ollama pull gpt-oss:20b nomic-embed-text`;
#       gpt-oss:20b is ~13 GB):
#           LLM_BASE_URL=http://host.docker.internal:11434/v1
#           LLM_TIMEOUT_S=120
#
# scripts/quickstart.ps1 verifies both models are present at LLM_BASE_URL before
# it declares the stack ready, and prints exactly what to fix if not.
LLM_BASE_URL=http://100.88.247.106:11434/v1
LLM_TIMEOUT_S=300
LLM_MODEL_GENERATION=gpt-oss:20b
LLM_MODEL_EMBEDDING=nomic-embed-text
# CONTRACT: must equal the Neo4j vector-index `vector.dimensions`. Changing the
# embedding model means changing this AND rebuilding the vector indexes.
LLM_EMBEDDING_DIM=768

# ── Storage — filesystem BlobStore (no MinIO/S3) ────────────────────────────
STORAGE_DIR=/data

# ── Privacy ─────────────────────────────────────────────────────────────────
# REQUIRED. pgcrypto key for candidate PII (name/email/phone/cover letter),
# loaded into the app.pii_key GUC. Generate 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Losing this key makes every encrypted column unrecoverable. Never commit it.
PII_KEY=
# REQUIRED (ADR-008). Salt folded into every NON-VOCAB skill's Neo4j graph
# key (a closed-vocabulary skill's key stays plain cleartext; anything else
# is salted-hashed so a candidate's own name, mis-extracted as a "skill",
# can never land in the graph as cleartext or an embedding). Generate the
# same way as PII_KEY:
#   openssl rand -base64 32
# Rotating this value requires re-projecting the whole graph (every job and
# résumé re-parsed) to reconnect REQUIRES/HAS_SKILL edges under the new keys.
SKILL_HASH_SALT=
# Blind review (name/email/phone redacted in the viewer) is ON by default.
BLIND_REVIEW_DEFAULT=true

# ── Gates ───────────────────────────────────────────────────────────────────
COVERAGE_THRESHOLD=80

# ── Flask viewer ────────────────────────────────────────────────────────────
API_BASE_URL=http://api:8000
FLASK_SECRET_KEY=change-me
