__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Filesystem BlobStore root (resumes, cover letters — never commit candidate data)
/data/

# Real candidate résumés and JDs — NEVER commit. This repository is PUBLIC,
# and these are third-party PII (names, contact details, employment history)
# under PIPEDA/FIPPA. A `git add -A` swept them in on 2026-08-21 (349aadd) and
# pushed 99MB to a public remote; see HANDOFF.md.
fixtures/

# Box-local compose overrides (CAS off on a dev box, a corrected timeout).
# Never committed: an override that reaches another checkout changes that
# machine's behaviour invisibly, and one of these turns authentication OFF.
docker-compose.override.yml
compose.override.yml

# Stress/e2e harness output and env — never committed. `.env.*` also catches
# `sed -i.bak`-style backup files (a `.env.bak` carries the same secrets as
# `.env` and is not gitignored by the plain `.env` rule above) and any
# `.env.stress`-style variant — `.env.example` is the one intentional
# exception, since it ships no real secret.
/report/
*.roster.csv
.env.*
!.env.example
